# Copy to .env and adjust. .env is git-ignored and docker-ignored - never commit real passwords.

# --- Database ---
DB_NAME=travelease
DB_USER=travelease
DB_PASSWORD=change-me-please

# --- Application ---
ASPNETCORE_ENVIRONMENT=Production
APP_VERSION=1.0.0
APP_PORT=8080
SEED_SAMPLE_DATA=true
CURRENCY_SYMBOL=₹

# --- Build ---
BUILD_CONFIGURATION=Release
# DOCKERFILE=docker/Dockerfile.instructions
