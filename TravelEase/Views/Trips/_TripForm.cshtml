@model TripFormModel
<form asp-controller="Trips" asp-action="@(Model.IsEdit ? "Edit" : "Create")" asp-route-id="@Model.Id" method="post" data-ajax-form novalidate>
    <div class="modal-header">
        <div class="modal-icon tint-orange"><i class="bi bi-airplane-engines"></i></div>
        <div>
            <h5 class="modal-title">@(Model.IsEdit ? $"Edit trip {Model.TripCode}" : "Add trip")</h5>
            <p class="modal-subtitle">Route, schedule, inventory and pricing. Times are in UTC.</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="TripCode" class="form-label"></label>
                <input asp-for="TripCode" class="form-control text-uppercase" />
                <span asp-validation-for="TripCode" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="TransportType" class="form-label"></label>
                <select asp-for="TransportType" asp-items="Html.GetEnumSelectList<TransportType>()" class="form-select"></select>
            </div>
            <div class="col-md-4">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<TripStatus>()" class="form-select"></select>
            </div>
            <div class="col-md-6">
                <label asp-for="Source" class="form-label"></label>
                <div class="input-icon"><i class="bi bi-geo"></i><input asp-for="Source" class="form-control" placeholder="e.g. Mumbai" /></div>
                <span asp-validation-for="Source" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Destination" class="form-label"></label>
                <div class="input-icon"><i class="bi bi-geo-alt"></i><input asp-for="Destination" class="form-control" placeholder="e.g. Dubai" /></div>
                <span asp-validation-for="Destination" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="DepartureDate" class="form-label"></label>
                <input asp-for="DepartureDate" class="form-control" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                <span asp-validation-for="DepartureDate" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="ArrivalDate" class="form-label"></label>
                <input asp-for="ArrivalDate" class="form-control" type="datetime-local" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                <span asp-validation-for="ArrivalDate" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="TotalSeats" class="form-label"></label>
                <input asp-for="TotalSeats" class="form-control" type="number" min="1" max="1000" />
                <span asp-validation-for="TotalSeats" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="TicketPrice" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">@Fmt.Currency</span>
                    <input asp-for="TicketPrice" class="form-control" type="number" min="1" step="0.01" />
                </div>
                <span asp-validation-for="TicketPrice" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Operator" class="form-label"></label>
                <input asp-for="Operator" class="form-control" placeholder="e.g. Emirates" />
                <span asp-validation-for="Operator" class="invalid-feedback d-block"></span>
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="2" placeholder="Package inclusions, baggage, notes…"></textarea>
                <span asp-validation-for="Description" class="invalid-feedback d-block"></span>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary" data-loading-text="Saving…"><i class="bi bi-check-lg me-1"></i>@(Model.IsEdit ? "Save changes" : "Create trip")</button>
    </div>
</form>
