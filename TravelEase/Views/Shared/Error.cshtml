@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}
<div class="empty-state error-state">
    <div class="error-code">@Model.StatusCode</div>
    <h1 class="h3 fw-semibold">@Model.Title</h1>
    <p class="text-muted">@Model.Message</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <div class="d-flex gap-2 justify-content-center mt-3">
        <a href="/" class="btn btn-primary"><i class="bi bi-house me-1"></i>Back to dashboard</a>
        <button type="button" class="btn btn-light" onclick="history.back()">Go back</button>
    </div>
</div>
