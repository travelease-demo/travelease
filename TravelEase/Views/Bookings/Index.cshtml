@model BookingIndexViewModel
@{
    var page = Model.Bookings;
    var f = Model.Filter;
    string TabUrl(BookingStatus? status) => Url.Action("Index", new { status, search = f.Search, from = f.From?.ToString("yyyy-MM-dd"), to = f.To?.ToString("yyyy-MM-dd") })!;
}

<div class="page-header">
    <div>
        <h1 class="page-title">Bookings</h1>
        <p class="page-subtitle">Create, confirm and cancel reservations · @Fmt.Number(Model.AllCount) bookings in view</p>
    </div>
    <div class="page-actions">
        <button class="btn btn-primary" data-modal-url="@Url.Action("Create")"><i class="bi bi-plus-lg me-1"></i>New booking</button>
    </div>
</div>

<div class="card-panel">
    <div class="status-tabs">
        <a href="@TabUrl(null)" class="@(f.Status is null ? "active" : "")">All <span>@Model.AllCount</span></a>
        @foreach (var s in Enum.GetValues<BookingStatus>())
        {
            <a href="@TabUrl(s)" class="@(f.Status == s ? "active" : "")"><i class="dot @UiFormatter.StatusClass(s)"></i>@s <span>@Model.StatusCounts[s]</span></a>
        }
    </div>

    <form class="filter-bar" method="get" data-auto-submit>
        @if (f.Status.HasValue)
        {
            <input type="hidden" name="status" value="@f.Status" />
        }
        <div class="input-icon flex-grow-1">
            <i class="bi bi-search"></i>
            <input type="search" class="form-control" name="search" value="@f.Search" placeholder="Reference, customer, email, trip code or city…" />
        </div>
        <input type="date" name="from" class="form-control w-auto" value="@f.From?.ToString("yyyy-MM-dd")" title="Booked from" aria-label="Booked from" />
        <input type="date" name="to" class="form-control w-auto" value="@f.To?.ToString("yyyy-MM-dd")" title="Booked to" aria-label="Booked to" />
        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-funnel me-1"></i>Filter</button>
        @if (!string.IsNullOrEmpty(f.Search) || f.From.HasValue || f.To.HasValue || f.Status.HasValue)
        {
            <a class="btn btn-link text-decoration-none" asp-action="Index">Clear</a>
        }
    </form>

    @if (!page.Items.Any())
    {
        <div class="empty-state">
            <i class="bi bi-ticket-perforated"></i>
            <h3>No bookings found</h3>
            <p>Try another filter or create a new booking.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-modern align-middle mb-0">
                <thead>
                <tr>
                    <th>Reference</th>
                    <th>Customer</th>
                    <th>Trip</th>
                    <th>Departure</th>
                    <th class="text-center">Pax</th>
                    <th class="text-end">Total</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var b in page.Items)
                {
                    <tr>
                        <td>
                            <a class="ref-code" asp-action="Details" asp-route-id="@b.Id">@b.BookingReference</a>
                            <div class="small text-muted">@Fmt.DateTimeShort(b.BookingDate)</div>
                        </td>
                        <td>
                            <a class="d-flex align-items-center gap-2 text-reset text-decoration-none" asp-controller="Customers" asp-action="Details" asp-route-id="@b.CustomerId">
                                <span class="avatar avatar-sm @UiFormatter.AvatarClass(b.Customer!.FullName)">@b.Customer.Initials</span>
                                <span class="text-truncate">@b.Customer.FullName</span>
                            </a>
                        </td>
                        <td>
                            <span class="route-inline">@b.Trip!.Source <i class="bi bi-arrow-right"></i> @b.Trip.Destination</span>
                            <div class="small text-muted"><i class="bi @UiFormatter.TransportIcon(b.Trip.TransportType) me-1"></i>@b.Trip.TripCode</div>
                        </td>
                        <td class="small text-nowrap">@Fmt.Date(b.Trip.DepartureDate)</td>
                        <td class="text-center">@b.Passengers</td>
                        <td class="text-end fw-semibold">@Fmt.Money(b.TotalPrice)</td>
                        <td><partial name="_BookingStatus" model="b.Status" /></td>
                        <td class="text-end text-nowrap">
                            @if (b.Status == BookingStatus.Pending)
                            {
                                <button class="btn btn-sm btn-icon text-success" title="Confirm"
                                        data-confirm-action="@Url.Action("Confirm", new { id = b.Id })"
                                        data-confirm-title="Confirm @b.BookingReference?"
                                        data-confirm-message="@b.Passengers passenger(s) · @Fmt.Money(b.TotalPrice). The customer's seats will be confirmed."
                                        data-confirm-button="Confirm booking" data-confirm-variant="success"><i class="bi bi-check2-circle"></i></button>
                            }
                            @if (b.Status != BookingStatus.Cancelled)
                            {
                                <button class="btn btn-sm btn-icon text-danger" title="Cancel" data-modal-url="@Url.Action("Cancel", new { id = b.Id })"><i class="bi bi-x-circle"></i></button>
                            }
                            <a class="btn btn-sm btn-icon" asp-action="Details" asp-route-id="@b.Id" title="View"><i class="bi bi-eye"></i></a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    @await Html.PartialAsync("_Pagination", (page.Page, page.TotalPages, page.FirstItem, page.LastItem, page.TotalCount, "bookings"))
</div>
