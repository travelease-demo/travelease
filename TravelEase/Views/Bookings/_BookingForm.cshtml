@model BookingFormViewModel
<form asp-controller="Bookings" asp-action="Create" method="post" data-ajax-form data-booking-form novalidate>
    <div class="modal-header">
        <div class="modal-icon tint-blue"><i class="bi bi-ticket-perforated"></i></div>
        <div>
            <h5 class="modal-title">New booking</h5>
            <p class="modal-subtitle">Select a customer and an open trip. Price is calculated automatically.</p>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>
        <div class="row g-4">
            <div class="col-md-7">
                <div class="mb-3">
                    <label asp-for="Input.CustomerId" class="form-label"></label>
                    <select asp-for="Input.CustomerId" asp-items="Model.Customers" class="form-select">
                        <option value="0">Select a customer…</option>
                    </select>
                    <span asp-validation-for="Input.CustomerId" class="invalid-feedback d-block"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.TripId" class="form-label"></label>
                    <select asp-for="Input.TripId" class="form-select" data-trip-select>
                        <option value="0">Select a trip…</option>
                        @foreach (var t in Model.Trips)
                        {
                            <option value="@t.Id" data-price="@t.TicketPrice" data-seats="@t.AvailableSeats"
                                    data-departure="@Fmt.DateTimeShort(t.DepartureDate) UTC" data-route="@t.Route">
                                @t.TripCode · @t.Route · @Fmt.Date(t.DepartureDate) · @Fmt.Money(t.TicketPrice) (@t.AvailableSeats left)
                            </option>
                        }
                    </select>
                    <span asp-validation-for="Input.TripId" class="invalid-feedback d-block"></span>
                    @if (!Model.Trips.Any())
                    {
                        <div class="form-text text-warning">No trips are currently open for booking.</div>
                    }
                </div>
                <div class="row g-3">
                    <div class="col-sm-5">
                        <label asp-for="Input.Passengers" class="form-label"></label>
                        <div class="input-group stepper">
                            <button class="btn btn-outline-secondary" type="button" data-step="-1" aria-label="Fewer passengers"><i class="bi bi-dash"></i></button>
                            <input asp-for="Input.Passengers" class="form-control text-center" type="number" min="1" max="20" data-passengers />
                            <button class="btn btn-outline-secondary" type="button" data-step="1" aria-label="More passengers"><i class="bi bi-plus"></i></button>
                        </div>
                        <span asp-validation-for="Input.Passengers" class="invalid-feedback d-block"></span>
                    </div>
                    <div class="col-sm-7 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="Input.ConfirmImmediately" class="form-check-input" role="switch" />
                            <label asp-for="Input.ConfirmImmediately" class="form-check-label"></label>
                            <div class="form-text mt-0">Off = keep as <em>Pending</em> (seats are held).</div>
                        </div>
                    </div>
                </div>
                <div class="mt-3">
                    <label asp-for="Input.Notes" class="form-label">Notes <span class="text-muted fw-normal">(optional)</span></label>
                    <textarea asp-for="Input.Notes" class="form-control" rows="2" placeholder="Meal preferences, special assistance, invoicing…"></textarea>
                    <span asp-validation-for="Input.Notes" class="invalid-feedback d-block"></span>
                </div>
            </div>
            <div class="col-md-5">
                <div class="price-summary" data-price-summary>
                    <h6>Booking summary</h6>
                    <div class="summary-route" data-summary-route>No trip selected</div>
                    <div class="small text-muted mb-3" data-summary-departure>&nbsp;</div>
                    <dl>
                        <dt>Ticket price</dt><dd data-summary-price>—</dd>
                        <dt>Passengers</dt><dd data-summary-pax>—</dd>
                        <dt>Seats remaining</dt><dd data-summary-seats>—</dd>
                    </dl>
                    <div class="summary-total">
                        <span>Total</span>
                        <strong data-summary-total>—</strong>
                    </div>
                    <div class="small text-danger mt-2 d-none" data-summary-warning><i class="bi bi-exclamation-triangle me-1"></i>Not enough seats on this trip.</div>
                    <div class="small text-muted mt-3"><i class="bi bi-info-circle me-1"></i>A booking reference (e.g. TE-YYMMDD-XXXXX) is generated on save.</div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary" data-loading-text="Creating booking…"><i class="bi bi-check-lg me-1"></i>Create booking</button>
    </div>
</form>
