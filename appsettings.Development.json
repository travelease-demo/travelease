{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=travelease;Username=travelease"
  },
  "Database": {
    "MaxStartupRetries": 3,
    "RetryDelaySeconds": 3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "TravelEase": "Debug"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "IncludeScopes": false,
        "TimestampFormat": "HH:mm:ss "
      }
    }
  }
}
