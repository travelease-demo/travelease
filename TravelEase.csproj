<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TravelEase</RootNamespace>
    <AssemblyName>TravelEase</AssemblyName>

    <!-- Default version. Override at build time: dotnet publish -p:Version=1.2.3
         (the Dockerfiles pass the APP_VERSION build ARG through to this property). -->
    <Version>1.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Keeps the published output small and predictable for container images. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <!-- Docker learning material, docs, locally published output and runtime data are not part of the app. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);docker/**;docs/**;publish/**;data/**</DefaultItemExcludes>
  </PropertyGroup>

</Project>
